PRINT '--- ПРОВЕРКА: Процедуры, функции, триггеры ---';

SELECT 
    name AS ObjectName,
    type_desc AS ObjectType,
    create_date AS CreatedDate,
    modify_date AS ModifiedDate
FROM sys.objects
WHERE type IN ('P', 'FN', 'IF', 'TF', 'TR', 'V')
ORDER BY type_desc, name;



