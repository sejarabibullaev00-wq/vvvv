PRINT '--- ТЕСТ 1: Проверка наличия данных в таблицах ---';

SELECT 
    t.name AS TableName,
    SUM(p.rows) AS RowCounts
FROM sys.tables t
JOIN sys.partitions p ON t.object_id = p.object_id
WHERE p.index_id IN (0, 1)
GROUP BY t.name
HAVING SUM(p.rows) = 0; 
-- Если запрос вернул строки - значит в этих таблицах НЕТ данных


PRINT '--- ТЕСТ 2: Проверка на дубликаты (пример для таблицы Users) ---';
-- ЗАМЕНИТЕ Users и UserID на ваши реальные таблицу и колонку

SELECT 
    UserID, 
    COUNT(*) AS DuplicateCount
FROM Users
GROUP BY UserID
HAVING COUNT(*) > 1;





PRINT '--- ТЕСТ 3: Проверка вычисляемых столбцов ---';

